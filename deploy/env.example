# /etc/paneld/env: secrets for paneld, read by systemd (EnvironmentFile=, see
# https://www.freedesktop.org/software/systemd/man/latest/systemd.exec.html).
#
# Install with the right owner and mode BEFORE putting real values in it:
#   sudo install -d -m 755 /etc/paneld
#   sudo install -m 600 -o root -g root deploy/env.example /etc/paneld/env
#   sudoedit /etc/paneld/env
# systemd (root) reads this file, so it does not need to be readable by the
# service user. Never commit the edited file, and never put these values in
# config.toml: the config only names the variables (`token_env = "HA_TOKEN"`).
#
# Format: one NAME=value per line, no `export`. Lines starting with # or ; are
# comments. Quote a value that has spaces or a `#`. No trailing comments on
# a value line.
#
# The NAMES below must match the `*_env` settings in your config.toml; they are
# the ones used in config/example.toml. Remove the lines you do not use.
# paneld refuses to start if a variable named in the config is unset or empty.

# [http] token_env: bearer token for every /api/* route.
# Generate one with: head -c 32 /dev/urandom | base64 | tr -d '=+/'
PANELD_API_TOKEN=replace-with-a-long-random-token

# [sources.*] type = "home_assistant": long-lived access token (HA profile page, "Security").
HA_TOKEN=replace-with-home-assistant-long-lived-token

# [mqtt] password_env (Home Assistant discovery entities), needs `username`.
PANELD_MQTT_PASSWORD=replace-with-mqtt-password

# [sources.*] type = "mqtt" password_env, if it uses its own name.
MQTT_PASSWORD=replace-with-mqtt-password

# [sources.*] type = "http_poll" header_env: header name -> variable name,
# e.g. header_env = { "X-Api-Key" = "WEATHER_API_KEY" }
WEATHER_API_KEY=replace-with-api-key

# [sources.*] type = "prometheus" bearer_env.
PROM_TOKEN=replace-with-prometheus-bearer-token

# Not a secret: log filter (tracing EnvFilter syntax, default "info").
#RUST_LOG=info
